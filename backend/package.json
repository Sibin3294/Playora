{
  "name": "number-hunter-api",
  "private": true,
  "version": "1.0.0",
  "description": "Playora / Number Hunter API (GuessGame monorepo backend)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/catalog && cp -R src/catalog/data dist/catalog/",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:3100": "PORT=3100 tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
